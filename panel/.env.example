# Скопируйте в .env и заполните. Файл .env в git не попадает.

# Порт и адрес, на которых слушает веб-панель
PORT=3000
HOST=0.0.0.0

# Публичный адрес панели — нужен для Steam OpenID (realm/return_to).
# Локально: http://localhost:3000 , на сервере: https://panel.example.com
PUBLIC_BASE_URL=http://localhost:3000

# Секрет для подписи сессий: сгенерируйте свой, например: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me

# Steam Web API ключ (https://steamcommunity.com/dev/apikey) — нужен только для имён и аватарок
STEAM_API_KEY=

# SteamID64 админов панели через запятую (у них есть доступ к RCON)
ADMIN_STEAM_IDS=76561190000000000

# Разрешить добавлять/удалять серверы из веб-интерфейса (0 — только сервер из env)
ALLOW_SERVER_MANAGEMENT=1

# DEMO_MODE=1 — всегда показывать демо-данные, даже если сервер настроен
DEMO_MODE=0

# DEMO_ADMIN=1 (только вместе с DEMO_MODE=1) — заходить сразу админом без Steam, для локальной демонстрации
DEMO_ADMIN=0

# --- Виртуальная экономика (монеты НЕ имеют реальной стоимости) ---
START_COINS=1000        # стартовый баланс нового игрока
DAILY_COINS=250         # ежедневный бонус
DAILY_COOLDOWN_HOURS=20
MAX_CHANCE=0.8          # максимальный шанс апгрейда (80%) — выше не поднимается никогда
UPGRADE_EDGE=0.95       # коэффициент для сводок (в шансах больше не участвует)
CURRENCY=coins          # в какой валюте показывать цены: coins (монеты) | rub (рубли) | usd (доллары)
RATE_RUB=1              # множитель к цене в рублях (1 = как есть)
RATE_USD=1              # множитель к цене в долларах (1 = как есть)
COIN_RATE_RUB=10        # сколько рублей в одной монете: цена со Steam в ₽ делится на это число
CASE_EDGE=0.95          # цена кейса = математическое ожидание дропа × CASE_EDGE

# Реальные цены с торговой площадки Steam (нужен доступ в интернет с сервера панели)
PRICE_SYNC_ENABLED=1    # 0 — выключить синхронизацию цен
PRICE_SYNC_DELAY_MS=1200# пауза между запросами (Steam режет частые)
PRICE_SYNC_BATCH=150    # сколько предметов обновлять за один проход
PRICE_SYNC_HOURS=0      # автообновление раз в N часов (0 — выключено)
USD_RUB=95              # курс для пересчёта цены в доллары
                        # пресеты по множителям (x2..x50) меняются уже в админке,
                        # здесь задаётся только общая база
SELL_RATE=0.85          # доля цены, возвращаемая при продаже предмета обратно

# --- Серверный плагин скинов (cs2-server/plugins/PanelSkins) ---
# Общий ключ для всех плагинов; если пуст — используется ключ конкретного сервера
# из админки (вкладка «Настройки» → «новый ключ»).
PLUGIN_API_KEY=

# --- Один сервер можно задать через окружение (остальные добавляются из панели) ---
CS2_NAME=Relog CS2 #1
CS2_RCON_HOST=127.0.0.1
CS2_GAME_PORT=27015
CS2_RCON_PORT=27015
CS2_RCON_PASSWORD=

# Каталог с данными (store.json, skins.json)
# DATA_DIR=./data
